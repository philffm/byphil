FROM nginx:alpine

# Copy a minimal nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static site files (generated by `npm run build`; one folder per language)
COPY index.html terms.html sitemap.xml robots.txt /usr/share/nginx/html/
COPY de/ /usr/share/nginx/html/de/
COPY css/ /usr/share/nginx/html/css/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
